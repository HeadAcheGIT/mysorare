generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Club {
  slug       String   @id
  name       String
  country    String?
  pictureUrl String?
  players    Player[]

  /// The club's domestic league, from the public API's `Club.domesticLeague`.
  /// Powers the division/championship badge on a player's card.
  competitionSlug String?
  competitionName String?
  /// League position, 1 = top. Feeds the fixture-difficulty adjustment — see
  /// fixtureDifficultyFactor in lib/services/publicProjection.ts, which only
  /// ever compares it against the opponent in the same match because it isn't
  /// meaningful across competitions.
  leagueRanking   Int?
}

model Player {
  slug         String    @id
  displayName  String
  position     String
  age          Int?
  clubSlug     String?
  club         Club?     @relation(fields: [clubSlug], references: [slug])
  injuryStatus String?
  injuryUntil  DateTime?
  suspended    Boolean   @default(false)
  updatedAt    DateTime  @updatedAt
  /// From the public API's `Player.birthDate`. Powers the U23 badge — a
  /// player is U23-eligible while under 23 years old, so their "eligible
  /// until" date is exactly their 23rd birthday.
  birthDate    DateTime?

  // Filled by the public (unauthenticated) Sorare API — see lib/sorare/publicClient.ts.
  pictureUrl                String?
  country                   String?
  shirtNumber               Int?
  /// Sorare's own projection for the next fixture. Kept distinct from our
  /// computed Projection.expectedScore so the two can be compared rather than
  /// one silently overwriting the other.
  sorareProjection          Float?
  /// Sorare's own starter probability for the next Classic fixture, licensed
  /// from a data partner (see providerName/providerIconUrl below) — the
  /// `nextClassicFixturePlayingStatusOdds` field on the public API. Kept
  /// distinct from our own Projection.pStart for the same reason as
  /// sorareProjection above: so the two can be graded against each other
  /// instead of one silently overwriting the other. Classic fixtures only —
  /// no equivalent field exists for Daily on the current schema.
  sorareStarterOdds         Float?
  sorareOddsProviderName    String?
  sorareOddsProviderIconUrl String?
  sorareOddsReliability     String?
  /// Last few So5 scores, newest first, JSON-encoded. Powers the form
  /// sparkline without needing a row per game — Appearance still holds the
  /// full per-game detail when an authenticated sync has run.
  recentScores              String?
  enrichedAt                DateTime?

  /// Appearances in the club's last 5 / 15 games. This is the playing-time
  /// signal the public API gives us in place of per-game minutes, and it's
  /// what the start probability is built from (see projections.ts).
  app5              Int?
  app15             Int?
  seasonAppearances Int?
  /// Sorare's own rolling averages. avgL10Played only counts games actually
  /// played, so it reads as "how good when he plays" rather than "how often".
  avgL5             Float?
  avgL15            Float?
  avgL10Played      Float?
  cards             Card[]
  appearances       Appearance[]
  projections       Projection[]
  overrides         Override[]
  projectionSources ProjectionSource[]
}

model Card {
  slug         String   @id
  assetId      String?
  playerSlug   String
  player       Player   @relation(fields: [playerSlug], references: [slug])
  rarity       String
  season       Int?
  inSeason     Boolean  @default(false)
  serialNumber Int?
  bonus        Float    @default(0)
  updatedAt    DateTime @updatedAt

  /// Where this card came from: "csv" (SorareScore gallery export) or "api"
  /// (authenticated Sorare sync). Lets an import replace only what it owns,
  /// so a CSV refresh can drop sold cards without touching API-synced ones.
  source String @default("api")

  // Valuations from the SorareScore export, in EUR. Null when the card came
  // from the API sync, which doesn't carry these.
  price          Float?
  floorPrice     Float?
  estimatedPrice Float?
  boughtPrice    Float?
  /// SorareScore's 10-game average for this card's player at export time.
  l10            Float?

  @@index([playerSlug])
}

model Fixture {
  slug      String    @id
  startDate DateTime?
  endDate   DateTime?
  state     String?

  /// When line-ups lock. The whole point of the game-week view: everything
  /// else is advice, this is the deadline it has to beat.
  cutOffDate  DateTime?
  displayName String?
  gameWeek    Int?
}

model Appearance {
  id             Int       @id @default(autoincrement())
  playerSlug     String
  player         Player    @relation(fields: [playerSlug], references: [slug])
  gameId         String
  gameDate       DateTime?
  competition    String?
  minutes        Int       @default(0)
  /// Whether the player was in the starting XI. Derived from formationPlace
  /// when it's known (see below), which is the only reliable answer — the old
  /// `minutes >= 60` proxy got it wrong in both directions: it missed starters
  /// subbed at half time and, on the appearance-count model, counted a
  /// one-minute cameo as a full start.
  started        Boolean   @default(false)
  /// Place in the starting formation, from PlayerGameStats.formationPlace.
  /// Non-zero means the player started; 0 means bench or unused. Null when the
  /// row predates this field or came from a source that doesn't carry it
  /// (API-Football friendlies), in which case `started` falls back to minutes.
  formationPlace Int?
  onGameSheet    Boolean   @default(false)
  score          Float?

  /// Club friendlies (pre-season) come from API-Football, not Sorare — see
  /// lib/services/friendlies.ts. Sorare's public API carries international
  /// friendlies but no club pre-season games at all, which is exactly the
  /// window where you most need to know who is actually playing again.
  goals    Int?
  assists  Int?
  /// API-Football's own match rating (~1-10). No So5 score exists for a
  /// friendly, so this is the only quality signal available for these games.
  rating   Float?
  friendly Boolean @default(false)
  /// "sorare" | "api_football"
  source   String  @default("sorare")

  @@unique([playerSlug, gameId])
  @@index([playerSlug])
}

model Projection {
  id            Int      @id @default(autoincrement())
  playerSlug    String
  player        Player   @relation(fields: [playerSlug], references: [slug])
  fixtureSlug   String
  pStart        Float    @default(0)
  confidence    Float    @default(0) // 0-1, how much the sources agree — see ProjectionSource
  expectedScore Float    @default(0)
  floorScore    Float    @default(0)
  l5            Float?
  l15           Float?
  gamesInWeek   Int      @default(1)
  note          String?
  computedAt    DateTime @default(now())

  /// Probability of appearing at all, starter or off the bench. Kept separate
  /// from pStart because they answer different questions and are needed for
  /// different things: expectedScore is driven by pPlay (a substitute still
  /// scores), while pStart is what a manager reads as "titulaire". Collapsing
  /// the two is what made the old numbers wrong.
  pPlay       Float?
  /// What pStart actually measures, so the UI can say so instead of labelling
  /// everything "titulaire":
  ///   "starts"      — real per-game starting XI data (Appearance.formationPlace)
  ///   "appearances" — no per-game history yet, so this is p(plays at all)
  ///                   standing in for p(starts) and overstating it
  ///   "baseline"    — no history at all, position prior only
  pStartBasis String @default("appearances")

  /// Snapshot of Player.sorareStarterOdds/sorareOddsProviderName at the time
  /// this row was computed — unlike the Player copy (overwritten every sync),
  /// this stays put once the fixture has passed, so it can be graded against
  /// the real outcome later. See Player.sorareStarterOdds for what it is.
  sorareStarterOdds      Float?
  sorareOddsProviderName String?

  @@unique([playerSlug, fixtureSlug])
  @@index([fixtureSlug])
}

/// What was actually fielded on Sorare for a fixture — one row per card in a
/// submitted lineup, sourced from the authenticated `mySo5Lineups` field (see
/// lib/services/alignedLineups.ts). This is the ground truth for "did I align
/// this player", grouped by division/leaderboard exactly like Sorare itself
/// splits a game week, used to grade both our own Projection.pStart and
/// Player/Projection.sorareStarterOdds against what was actually played.
model AlignedLineup {
  id              Int      @id @default(autoincrement())
  /// Sorare's own lineup id — stable across re-syncs, used with cardSlug as
  /// the upsert key so re-running the sync doesn't duplicate rows.
  so5LineupId     String
  fixtureSlug     String
  leaderboardSlug String?
  leaderboardName String?
  division        Int?
  playerSlug      String
  cardSlug        String
  captain         Boolean  @default(false)
  position        String?
  /// So5 score once the fixture has been played — null until then.
  actualScore     Float?
  syncedAt        DateTime @default(now())

  @@unique([so5LineupId, cardSlug])
  @@index([fixtureSlug])
  @@index([playerSlug])
}

/// What a game week actually returned: where each line-up finished and what it
/// paid. Sourced from the authenticated `mySo5Rankings` / `so5Rewards`, which
/// is the only record of real earnings — everything else in this app is a
/// projection. Without it there is no way to answer "is this gallery paying
/// for itself", which is the whole point of playing.
model SeasonReward {
  /// Sorare's own ranking id, stable across re-syncs.
  id              String   @id
  fixtureSlug     String
  gameWeek        Int?
  leaderboardSlug String
  leaderboardName String?
  division        Int?
  ranking         Int?
  score           Float?
  /// Cash reward in EUR. Null when the reward was cards only, 0 when nothing was won.
  rewardEur       Float?
  /// How many cards the finish paid out — the other half of the return.
  rewardCards     Int      @default(0)
  syncedAt        DateTime @default(now())

  @@index([fixtureSlug])
}

/// A Sorare "league track" for one game week — the level at which you enter
/// teams ("Champion Europe", "Contender", …), from the authenticated
/// `so5Fixture.mySo5LeagueTracks`. This is the real structure of the account,
/// replacing the hand-written COMPETITIONS list in lib/services/rules.ts as
/// the answer to "where can I actually play this week". Per fixture, because
/// eligibility and rewards change every game week.
model LeagueTrack {
  slug                 String
  fixtureSlug          String
  displayName          String
  /// "IN_SEASON" | "ALL_SEASONS" — drives the in-season advisor's filter.
  seasonality          String?
  seasonalityName      String?
  canCompose           Boolean  @default(false)
  canComposeReason     String?
  /// How many teams this track allows vs how many are actually unlocked.
  maxManagerTeams      Int      @default(0)
  unlockedManagerTeams Int      @default(0)
  lineupsCount         Int      @default(0)
  prizePool            Float?
  prizePoolCurrency    String?
  iconUrl              String?
  syncedAt             DateTime @default(now())

  divisions Division[]

  @@id([fixtureSlug, slug])
}

/// One So5Leaderboard — a division inside a league track. Carries Sorare's own
/// verdict on whether a line-up can be entered (`canCompose`) and exactly what
/// is missing, which is what the in-season advisor reasons over.
model Division {
  slug        String
  fixtureSlug String
  trackSlug   String?
  track       LeagueTrack? @relation(fields: [fixtureSlug, trackSlug], references: [fixtureSlug, slug], onDelete: Cascade)

  displayName String
  division    Int?
  rarityType  String?
  seasonality String?
  cutOffDate  DateTime?

  canCompose             Boolean @default(false)
  canComposeReason       String?
  missingCards           Int     @default(0)
  /// JSON arrays — the positions/rarities Sorare says are short.
  missingPositions       String?
  missingRarities        String?
  notEnoughEligibleCards Boolean @default(false)
  /// Sorare's own market filter string for the cards this division needs —
  /// surfaced as a link rather than re-derived, since it's their filter.
  transferMarketFilters  String?

  prizePool         Float?
  prizePoolCurrency String?
  divisionIconUrl   String?
  myLineupCount     Int      @default(0)
  syncedAt          DateTime @default(now())

  eligibility DivisionEligibility[]

  @@id([fixtureSlug, slug])
  @@index([fixtureSlug])
}

/// Per-position card counts for one division, from `eligibleCardsCountByPosition`.
/// `totalCount` is what you own that qualifies, `usedCardsCount` what is already
/// committed elsewhere — the difference is what you can still field.
model DivisionEligibility {
  id           Int      @id @default(autoincrement())
  fixtureSlug  String
  divisionSlug String
  division     Division @relation(fields: [fixtureSlug, divisionSlug], references: [fixtureSlug, slug], onDelete: Cascade)

  position       String
  seasonality    String?
  totalCount     Int     @default(0)
  usedCardsCount Int     @default(0)

  @@unique([fixtureSlug, divisionSlug, position, seasonality])
  @@index([fixtureSlug, divisionSlug])
}

/// One of the manager teams the account owns, with the division it currently
/// sits in — the "où j'en suis" half of the board.
model ManagerTeam {
  /// Sorare's own ManagerTeam id.
  id              String   @id
  fixtureSlug     String
  trackSlug       String?
  name            String
  activeDivision  Int?
  divisionIconUrl String?
  rarityType      String?
  seasonality     String?
  hidden          Boolean  @default(false)
  syncedAt        DateTime @default(now())

  @@index([fixtureSlug])
}

/// One source's independent read on a player's start probability for a fixture.
/// Projection.pStart is the weighted aggregate of these; Projection.confidence
/// reflects how much they agree. A source with pStart = null doesn't vote on
/// probability but can still carry a `detail` note (e.g. squad_depth explaining
/// why it has no reading yet).
model ProjectionSource {
  id          Int      @id @default(autoincrement())
  playerSlug  String
  player      Player   @relation(fields: [playerSlug], references: [slug])
  fixtureSlug String
  source      String // "internal_form" | "injury_status" | "fixture_congestion" | "squad_depth" | "external_probable"
  pStart      Float?
  weight      Float    @default(1)
  detail      String?
  fetchedAt   DateTime @default(now())

  @@unique([playerSlug, fixtureSlug, source])
  @@index([fixtureSlug])
}

model Override {
  id            Int      @id @default(autoincrement())
  playerSlug    String
  player        Player   @relation(fields: [playerSlug], references: [slug])
  fixtureSlug   String
  pStart        Float?
  expectedScore Float?
  exclude       Boolean  @default(false)
  note          String?
  createdAt     DateTime @default(now())

  @@unique([playerSlug, fixtureSlug])
}

model SavedLineup {
  id             Int      @id @default(autoincrement())
  fixtureSlug    String
  competition    String
  cardSlugs      String
  captainSlug    String?
  projectedTotal Float    @default(0)
  createdAt      DateTime @default(now())
}

model SyncLog {
  id     Int      @id @default(autoincrement())
  job    String
  status String
  detail String?
  ranAt  DateTime @default(now())
}

model TokenCache {
  id        Int      @id @default(1)
  token     String
  expiresAt DateTime

  /// How the token was obtained, because the two are not interchangeable:
  ///   "oauth" — Sorare Connect. Friendly (no 2FA, revocable), but its single
  ///             scope explicitly excludes future line-ups and rewards, so the
  ///             Compo board and the season report cannot run on it.
  ///   "jwt"   — email/password sign-in. Full access, 30-day token, but a new
  ///             IP re-triggers 2FA, which on serverless is most of the time.
  kind         String  @default("jwt")
  /// OAuth only: access tokens last 2 hours, so the refresh token is what
  /// makes Connect usable at all. Null for JWT.
  refreshToken String?
  nickname     String?
}

/// Live market floor, captured periodically for players actually owned or
/// watchlisted — not the whole market — so a price move can be detected
/// against the *previous* capture instead of only ever seeing "now".
model PriceSnapshot {
  id         Int      @id @default(autoincrement())
  playerSlug String
  rarity     String
  floorPrice Float
  capturedAt DateTime @default(now())

  @@index([playerSlug, rarity, capturedAt])
}

/// A CSV-sourced card that vanished from a later gallery export — sold or
/// transferred away, the CSV can't tell us which. Captured right before the
/// deletion csvImport.ts already did, so nothing is lost, just recorded.
model Sale {
  id                 Int      @id @default(autoincrement())
  cardSlug           String   @unique
  playerSlug         String
  playerName         String
  rarity             String
  season             Int?
  serialNumber       Int?
  /// What the export said this exact card was bought for, if known.
  boughtPrice        Float?
  /// Best-effort only: the CSV's last "Price" column before the card
  /// disappeared — SorareScore's own valuation, not a confirmed sale
  /// receipt. The export has no field for what a card actually sold for, so
  /// this is a stand-in the UI must label as an estimate, never a fact — used
  /// only until/unless the row below is filled in.
  lastKnownPrice     Float?
  lastFloorPrice     Float?
  lastEstimatedPrice Float?
  detectedAt         DateTime @default(now())

  /// The real thing, from Sorare's own transaction record
  /// (currentUser.soldSingleSaleTokenOffers) rather than inferred from a CSV
  /// diff — see syncSoldOffersFromSorare in lib/services/sales.ts. Requires
  /// being signed in to Sorare in-app; null until a sync has run. When set,
  /// the UI should prefer this over lastKnownPrice entirely.
  soldPrice         Float?
  soldAt            DateTime?
  /// True when soldPrice had to be derived from a wei-denominated Sorare
  /// offer via a historical ETH/EUR rate (see lib/services/ethRate.ts)
  /// because Sorare's own record carried no direct EUR figure for it. The UI
  /// must flag this as an approximation rather than presenting it as the
  /// exact confirmed price the way a direct eurCents figure is.
  soldPriceApprox   Boolean   @default(false)
  boughtPriceApprox Boolean   @default(false)
  /// "csv_diff" (inferred, see above) | "sorare_sync" (confirmed transaction)
  source            String    @default("csv_diff")

  @@index([playerSlug])
}

/// One calendar day's ETH→EUR rate, from CoinGecko's free historical-price
/// endpoint. A past day's rate never changes, so this is a permanent cache —
/// it exists purely to keep re-opening Historique from re-fetching the same
/// handful of dates and risking CoinGecko's free-tier rate limit. See
/// lib/services/ethRate.ts.
model EthRate {
  date      DateTime @id
  eurPerEth Float
  fetchedAt DateTime @default(now())
}

/// A standing signal worth a badge on the player's card: a live price swing,
/// or a transfer-flavoured headline. One row per (player, kind) — re-running
/// the check simply overwrites `detail`/`createdAt`, and the row is deleted
/// once the condition no longer holds, so its mere presence means "still true".
model PlayerAlert {
  id         Int      @id @default(autoincrement())
  playerSlug String
  /// "price_up" | "price_down" | "transfer_rumor"
  kind       String
  detail     String?
  createdAt  DateTime @default(now())

  @@unique([playerSlug, kind])
}

/// A named watchlist a player can be added to — e.g. "Cibles Ligue 1",
/// "Bons plans", one per scouting strategy rather than a single flat list.
model WatchlistGroup {
  id        Int             @id @default(autoincrement())
  name      String
  createdAt DateTime        @default(now())
  items     WatchlistItem[]
}

model WatchlistItem {
  id         Int            @id @default(autoincrement())
  playerSlug String
  label      String
  position   String?
  club       String?
  createdAt  DateTime       @default(now())
  groupId    Int
  group      WatchlistGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// A player can only appear once per list, but the same player can sit on
  /// several lists (e.g. tracked for two different strategies).
  @@unique([playerSlug, groupId])
  @@index([groupId])
}

/// Caches the mapping from our own club/player slugs to API-Football's ids,
/// so we search their /teams and /players endpoints once per entity instead
/// of on every lineup check (their free tier is 100 requests/day).
model ExternalTeamMapping {
  clubSlug          String   @id
  apiFootballTeamId Int
  updatedAt         DateTime @updatedAt
}

model ExternalPlayerMapping {
  playerSlug          String   @id
  apiFootballPlayerId Int
  updatedAt           DateTime @updatedAt
}
