# Neon Postgres — pooled connection string from your Neon project dashboard
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/cockpit?sslmode=require"

# Sorare
SORARE_EMAIL=you@example.com
SORARE_PASSWORD=your-new-password
SORARE_AUD=sorare-cockpit
SORARE_API_KEY=
SORARE_OTP=

# Random secret so only Vercel Cron (or you) can trigger /api/cron
CRON_SECRET=change-me-to-something-random

# Gate for the whole app (middleware.ts) — Vercel's SSO protection was
# disabled so the PWA works without a Vercel login, so this is the only
# thing protecting it. Required in production: with it unset, every request
# gets a 500. Any username works in the browser's Basic Auth prompt — only
# the password is checked.
APP_PASSWORD=change-me-to-something-random

# API-Football (api-sports.io) — free tier: 100 req/day, sign up at
# https://dashboard.api-football.com. Only used for the "vérifier les compos
# officielles" button, not the daily sync — leave empty if you don't want it.
APIFOOTBALL_KEY=
