# Neon Postgres — pooled connection string from your Neon project dashboard
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/cockpit?sslmode=require"

# Gate for the whole app (middleware.ts). Vercel's SSO protection is disabled
# so the PWA works without a Vercel login, so this is the only thing protecting
# it. Required in production: with it unset, every request gets a 500.
# Any username works in the browser prompt — only the password is checked.
APP_PASSWORD=change-me-to-something-random

# Lets Vercel Cron trigger /api/cron. ASCII only — Vercel sends it as an HTTP
# header and refuses to build if it contains accented characters.
CRON_SECRET=change-me-to-something-random

# Optional. The gallery comes from a SorareScore CSV export and everything else
# from Sorare's public API, so no Sorare credentials are needed. Signing in
# (in-app, Données tab) only unlocks the authenticated extras.
SORARE_AUD=sorare-cockpit

# Optional but worth having: raises Sorare's public API limits from 20 req/min
# and 500 query complexity to 600 req/min and 30000. Request one from Sorare.
SORARE_API_KEY=

# API-Football (api-sports.io) — free tier: 100 req/day. Only used by the
# "vérifier les compos officielles" button; leave empty if you don't want it.
APIFOOTBALL_KEY=
